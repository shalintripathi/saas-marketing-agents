# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Markdown files
*.md text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts: .bat and .cmd need CRLF, so they are stored as-is (no line-ending rule).
# PowerShell runs fine with LF.
*.ps1 text eol=lf

# Binary files
*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.font binary

# GitHub Linguist — this is a Markdown content/knowledge repo, not a shell project.
# Count Markdown toward language stats and treat helper scripts as tooling.
*.md linguist-detectable=true
*.md linguist-documentation=false
scripts/*.sh linguist-vendored=true

# Must stay after every rule that matches them (including `*` above).
*.bat -text
*.cmd -text
